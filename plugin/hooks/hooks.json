{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "docket",
            "args": ["hook", "session-start"],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "docket",
            "args": ["hook", "post-tool-use"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
